{
  "name": "ideabank",
  "description": "Manifesto de ambiente para o projeto ideabank",
  "runtimes": [
    {
      "command": "node",
      "minVersion": "22.0.0",
      "required": true,
      "description": "Ambiente de execução JavaScript/TypeScript nativo (ESM + strip-types)"
    },
    {
      "command": "npm",
      "minVersion": "9.0.0",
      "required": true,
      "description": "Gerenciador de pacotes"
    },
    {
      "command": "git",
      "required": true,
      "description": "Controle de versão"
    }
  ],
  "ports": [
    {
      "port": 5050,
      "expectedStatus": "free",
      "serviceName": "IdeaBank Fullstack Web Platform",
      "required": true
    }
  ],
  "envVars": [
    {
      "key": "PORT",
      "required": false,
      "description": "Porta padrão do servidor HTTP"
    }
  ],
  "services": []
}